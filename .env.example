# =========================================================
#  npm-registry-rust — example configuration
#  Copy to `.env` and adjust. Never commit the real `.env`.
# =========================================================

# ---- HTTP server ----
HOST=0.0.0.0
PORT=4873

# Public base URL of this registry, used to build tarball URLs inside
# packuments. Must be reachable by npm clients. No trailing slash.
REGISTRY_BASE_URL=http://localhost:4873

# ---- Storage ----
# Directory where package tarballs are written. Created automatically.
STORAGE_DIR=./storage

# ---- Database ----
# SQLite file path. Parent directory is created automatically.
DATABASE_URL=sqlite://./data/registry.db?mode=rwc

# ---- Auth ----
# HMAC secret for web session JWTs. MUST be >= 32 bytes.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Web session lifetime, in minutes.
SESSION_TTL_MINUTES=720

# ---- Bootstrap admin ----
# Created automatically on first start if the user table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# ---- Policy ----
# Allow self-service registration from `npm adduser` / the web UI.
ALLOW_REGISTRATION=false
# Maximum publish body size in MiB.
MAX_PUBLISH_BODY_MIB=64

# ---- Upstream proxying ----
# Registries consulted, in order, when a package is not published locally.
# The first upstream that answers wins; a 404 moves on to the next one. If every
# upstream fails (network / 5xx) the client gets a 502, never a misleading 404.
# Set to an empty value to disable proxying entirely.
UPSTREAM_REGISTRIES=https://registry.npmmirror.com,https://registry.npmjs.org

# Per-request timeout for upstream calls, in seconds.
UPSTREAM_TIMEOUT_SECONDS=30

# ---- CORS ----
# Comma-separated list of allowed origins. `*` is NOT allowed in production.
CORS_ALLOWED_ORIGINS=

# ---- Logging ----
# trace | debug | info | warn | error
RUST_LOG=info
# Set to `json` for structured logs (recommended in production).
LOG_FORMAT=text
